# cloud = api.vieneu.io (engine v4, tính phí theo ký tự) | local = server OpenAI-compatible tự host (v3 Turbo)
TTS_PROVIDER=cloud
VIENEU_API_KEY=vn_sk_...
VIENEU_CLOUD_URL=https://api.vieneu.io/api/v1
VIENEU_LOCAL_URL=http://localhost:8000/v1
VIENEU_LOCAL_MODEL=vieneu-v3-turbo
DEFAULT_VOICE=Ngọc Lan
CORS_ORIGINS=http://localhost:3000
AUDIO_CACHE_DIR=data/audio

ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-5-5
MAX_PREFETCH_CHARS=30000
