# cloud = api.vieneu.io | local = OpenAI-compatible | sdk = in-process VieNeu
TTS_PROVIDER=sdk
VIENEU_API_KEY=
VIENEU_CLOUD_URL=https://api.vieneu.io/api/v1
VIENEU_LOCAL_URL=http://localhost:8000/v1
VIENEU_LOCAL_MODEL=vieneu-v3-turbo
DEFAULT_VOICE=Minh Quân Pro
CORS_ORIGINS=http://localhost:3000
AUDIO_CACHE_DIR=

# --- Dịch truyện ---
# Anthropic Claude
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-4-5

# DeepSeek / OpenAI-compatible (rẻ, mạnh tiểu thuyết — mặc định DeepSeek)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
# auto | anthropic | openai
TRANSLATE_PROVIDER=auto

MAX_PREFETCH_CHARS=30000
